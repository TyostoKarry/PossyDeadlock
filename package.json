{
  "name": "possydeadlock",
  "version": "0.2.1",
  "description": "",
  "homepage": "https://github.com/TyostoKarry/PossyDeadlock#readme",
  "bugs": {
    "url": "https://github.com/TyostoKarry/PossyDeadlock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TyostoKarry/PossyDeadlock.git"
  },
  "license": "MIT",
  "author": "TyostoKarry",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.dev --import tsx/esm src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node --env-file=.env dist/index.js",
    "deploy": "node --env-file=.env --import tsx/esm src/deploy.ts",
    "deploy:dev": "node --env-file=.env.dev --import tsx/esm src/deploy.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "format": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "clear-seen": "node --env-file=.env --input-type=module --eval \"import { DatabaseSync } from 'node:sqlite'; const db = new DatabaseSync('./data/database.sqlite'); db.exec('DELETE FROM seen_posts'); console.log('Cleared seen posts');\"",
    "clear-seen:dev": "node --env-file=.env.dev --input-type=module --eval \"import { DatabaseSync } from 'node:sqlite'; const db = new DatabaseSync('./data/database.dev.sqlite'); db.exec('DELETE FROM seen_posts'); console.log('Cleared seen posts');\""
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
